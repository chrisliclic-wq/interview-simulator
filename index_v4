<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>升學面試模擬器</title>
<style>
:root{
  --bg:#f5f7ff; --bg2:#eef1ff; --card:#ffffff; --ink:#20263a; --ink2:#5a6480; --ink3:#8d97ae;
  --line:#e4e9f7; --brand:#4f5bd5; --brandL:#eef0ff; --brand2:#7c86ff;
  --coral:#ff7a59; --coralL:#fff0eb; --mint:#12b886; --mintL:#e6fbf4;
  --sun:#ffc078; --sunL:#fff5e6; --grape:#9775fa; --grapeL:#f3efff;
  --shadow:0 8px 24px rgba(52,64,110,.08); --shadow2:0 16px 44px rgba(52,64,110,.14);
  --r:18px;
}
body.dark{
  --bg:#12151f; --bg2:#171b28; --card:#1c2130; --ink:#e9edf8; --ink2:#aab4cc; --ink3:#79839e;
  --line:#2a3143; --brand:#8b95ff; --brandL:#252b45; --brand2:#a5adff;
  --coral:#ff9d85; --coralL:#33231e; --mint:#3ddca9; --mintL:#16312a;
  --sun:#ffcf94; --sunL:#332a1c; --grape:#b39bff; --grapeL:#2a2440;
  --shadow:0 8px 24px rgba(0,0,0,.35); --shadow2:0 16px 44px rgba(0,0,0,.45);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  background:
    radial-gradient(1100px 520px at 8% -8%, #fff, transparent 60%),
    radial-gradient(900px 460px at 100% 0%, var(--bg2), transparent 55%),
    var(--bg);
  color:var(--ink);
  font-family:"PingFang TC","Noto Sans TC","Microsoft JhengHei","微軟正黑體",system-ui,sans-serif;
  line-height:1.65; -webkit-font-smoothing:antialiased;
  -webkit-user-select:none; user-select:none; -webkit-tap-highlight-color:transparent;
  transition:background .3s,color .3s;
}
input,textarea{user-select:text;-webkit-user-select:text}
.wrap{max-width:1060px;margin:0 auto;padding:22px 16px 90px}
.nosel{-webkit-user-select:none;user-select:none}

/* ---------- header ---------- */
header.top{
  background:linear-gradient(120deg,var(--brand) 0%,var(--grape) 55%,var(--coral) 130%);
  color:#fff;border-radius:24px;padding:22px 24px;box-shadow:var(--shadow2);
  position:relative;overflow:hidden;margin-bottom:18px;
}
header.top:before{
  content:"";position:absolute;right:-60px;top:-80px;width:260px;height:260px;border-radius:50%;
  background:rgba(255,255,255,.14);
}
header.top:after{
  content:"";position:absolute;right:60px;bottom:-90px;width:180px;height:180px;border-radius:50%;
  background:rgba(255,255,255,.10);
}
.hrow{display:flex;align-items:flex-start;gap:14px;position:relative;z-index:2}
h1{font-size:27px;margin:0 0 3px;letter-spacing:.6px;text-shadow:0 2px 10px rgba(0,0,0,.12)}
.sub{font-size:14px;opacity:.92}
.hstats{display:flex;flex-wrap:wrap;gap:8px;margin-top:13px;position:relative;z-index:2}
.hchip{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);backdrop-filter:blur(4px);
  border-radius:999px;padding:4px 13px;font-size:12.5px;display:flex;align-items:center;gap:6px}
.hchip b{font-size:14.5px}
.hbtns{display:flex;gap:8px;margin-left:auto;position:relative;z-index:2}
.hbtn{background:rgba(255,255,255,.2);border:1px solid rgba(255,255,255,.3);color:#fff;border-radius:13px;
  width:40px;height:40px;cursor:pointer;font-size:17px;transition:.18s}
.hbtn:hover{background:rgba(255,255,255,.34);transform:translateY(-2px)}
.lockbar{margin-top:12px;display:flex;gap:8px;align-items:center;font-size:12px;opacity:.92;position:relative;z-index:2;flex-wrap:wrap}
.kbs{margin-top:7px;font-size:11.5px;opacity:.92;position:relative;z-index:2;display:flex;gap:6px;align-items:center;flex-wrap:wrap}
.kbs kbd{background:rgba(255,255,255,.22);border:1px solid rgba(255,255,255,.32);border-bottom-width:2px;border-radius:6px;
  padding:1px 6px;font-size:11px;font-family:inherit;color:#fff}

@media(max-width:520px){
  header.top{padding:16px 16px;border-radius:19px}
  h1{font-size:21px}
  .sub{font-size:12.5px}
  .hchip{font-size:11.5px;padding:3px 10px}
  .tabs{gap:6px}
  .tab{min-width:88px;font-size:12.5px;padding:9px 6px}
}
/* ---------- cards ---------- */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);padding:18px;margin-bottom:16px}
.card h2{font-size:14.5px;margin:0 0 14px;color:var(--ink2);font-weight:800;letter-spacing:.6px;display:flex;align-items:center;gap:9px}
.card h2 .em{font-size:17px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
.grid.two{grid-template-columns:repeat(2,1fr)}
@media(max-width:860px){.grid{grid-template-columns:repeat(2,1fr)}.grid.two{grid-template-columns:1fr}}
@media(max-width:520px){.grid{grid-template-columns:1fr}}
label.f{display:block;font-size:12px;color:var(--ink3);margin-bottom:5px;letter-spacing:.4px;font-weight:600}
select,input[type=text],input[type=password]{
  width:100%;padding:10px 12px;border:1.5px solid var(--line);border-radius:12px;background:var(--bg2);
  color:var(--ink);font-size:14px;font-family:inherit;outline:none;transition:.16s;
}
select:focus,input:focus{border-color:var(--brand);background:var(--card);box-shadow:0 0 0 4px var(--brandL)}
.checkline{display:flex;align-items:center;gap:8px;font-size:13.5px;color:var(--ink2);padding-top:22px}
.multi{position:relative}
.mbtn{width:100%;padding:10px 12px;border:1.5px solid var(--line);border-radius:12px;background:var(--bg2);
  color:var(--ink);font-size:14px;font-family:inherit;text-align:left;cursor:pointer;display:flex;align-items:center;gap:8px;transition:.16s;min-height:42px}
.mbtn:hover{border-color:var(--brand2)}
.mbtn.open{border-color:var(--brand);background:var(--card);box-shadow:0 0 0 4px var(--brandL)}
.mbtn .txt{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mbtn .arw{transition:.2s;color:var(--ink3);font-size:11px}
.mbtn.open .arw{transform:rotate(180deg)}
.mpanel{position:absolute;top:calc(100% + 6px);left:0;right:0;z-index:60;background:var(--card);border:1.5px solid var(--line);
  border-radius:15px;box-shadow:var(--shadow2);padding:12px;display:none;animation:pop .18s}
.mpanel.on{display:block}
.msearch{width:100%;padding:8px 10px;border:1.5px solid var(--line);border-radius:10px;background:var(--bg2);
  color:var(--ink);font-size:13px;font-family:inherit;outline:none;margin-bottom:8px}
.msearch:focus{border-color:var(--brand)}
.mopts{max-height:250px;overflow:auto;display:flex;flex-direction:column;gap:2px}
.mopt{display:flex;align-items:center;gap:9px;padding:7px 9px;border-radius:10px;cursor:pointer;font-size:13.5px;transition:.12s}
.mopt:hover{background:var(--bg2)}
.mopt input{width:16px;height:16px;accent-color:var(--brand);flex:none}
.mopt.dis{opacity:.45;cursor:not-allowed}
.mfoot{display:flex;justify-content:space-between;align-items:center;margin-top:9px;padding-top:9px;border-top:1px dashed var(--line);font-size:12px;color:var(--ink3)}
.mtag{display:inline-flex;align-items:center;gap:5px;background:var(--brandL);border:1px solid rgba(79,91,213,.25);
  color:var(--brand);border-radius:9px;padding:2px 8px;font-size:12px;font-weight:700;margin-right:5px}
.mtag b{cursor:pointer;font-size:13px;line-height:1}
.ensent{margin-top:11px;padding:10px 13px;border-radius:12px;background:var(--mintL);border:1px dashed rgba(18,184,134,.35);
  font-size:14px;color:var(--ink);font-weight:600;line-height:1.6}
.ensent .lb{display:block;font-size:11.5px;color:var(--mint);font-weight:800;letter-spacing:.5px;margin-bottom:3px}
.checkline input{width:17px;height:17px;accent-color:var(--brand)}
.hintbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin-top:14px;padding-top:13px;border-top:1px dashed var(--line)}
.count{font-size:13.5px;color:var(--ink2)}
.count b{color:var(--brand);font-size:18px;margin:0 2px}

.btn{border:1.5px solid var(--line);background:var(--card);color:var(--ink2);border-radius:12px;padding:9px 15px;
  font-size:13.5px;font-family:inherit;cursor:pointer;transition:.16s;display:inline-flex;align-items:center;gap:6px;font-weight:600}
.btn:hover{border-color:var(--brand);color:var(--brand);transform:translateY(-1px);box-shadow:var(--shadow)}
.btn:active{transform:translateY(0) scale(.98)}
.btn.primary{background:linear-gradient(120deg,var(--brand),var(--brand2));border-color:transparent;color:#fff;box-shadow:0 6px 16px rgba(79,91,213,.28)}
.btn.primary:hover{color:#fff;filter:brightness(1.06)}
.btn.coral{background:linear-gradient(120deg,var(--coral),#ff9a7d);border-color:transparent;color:#fff}
.btn.coral:hover{color:#fff}
.btn.mint{background:var(--mintL);border-color:rgba(18,184,134,.3);color:var(--mint)}
.btn.on{background:var(--mintL);border-color:var(--mint);color:var(--mint)}
.btn.sm{padding:6px 11px;font-size:12.5px;border-radius:10px}
.btn:disabled{opacity:.42;cursor:not-allowed;transform:none}
.btnrow{display:flex;flex-wrap:wrap;gap:9px}

/* ---------- tabs ---------- */
.tabs{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.tab{flex:1;min-width:104px;text-align:center;padding:11px 8px;border-radius:15px;border:1.5px solid var(--line);
  background:var(--card);cursor:pointer;font-size:14px;color:var(--ink2);font-weight:700;transition:.18s;box-shadow:var(--shadow)}
.tab:hover{border-color:var(--brand2);transform:translateY(-2px)}
.tab.active{background:linear-gradient(120deg,var(--brand),var(--grape));border-color:transparent;color:#fff;box-shadow:0 8px 20px rgba(79,91,213,.3)}
.tab small{display:block;font-size:11px;opacity:.85;font-weight:500}

/* ---------- question stage ---------- */
.stage{position:relative;overflow:hidden}
.qcard{animation:pop .38s cubic-bezier(.2,.9,.3,1.3)}
@keyframes pop{0%{opacity:0;transform:translateY(16px) scale(.97)}100%{opacity:1;transform:none}}
@keyframes flipin{0%{opacity:0;transform:perspective(900px) rotateX(-16deg) translateY(10px)}100%{opacity:1;transform:none}}
.flip{animation:flipin .45s cubic-bezier(.2,.9,.3,1.2)}
.tagrow{display:flex;flex-wrap:wrap;gap:7px;margin-bottom:13px}
.tag{font-size:12px;padding:3px 11px;border-radius:9px;background:var(--bg2);border:1px solid var(--line);color:var(--ink2);font-weight:600}
.tag.lang{background:var(--brandL);border-color:rgba(79,91,213,.22);color:var(--brand)}
.tag.type{background:var(--coralL);border-color:rgba(255,122,89,.25);color:var(--coral)}
.tag.hot{background:var(--sunL);border-color:rgba(255,192,120,.4);color:#e8890c}
.qbox{background:linear-gradient(135deg,var(--brandL),var(--card) 60%);border:1.5px solid var(--line);
  border-left:6px solid var(--brand);border-radius:16px;padding:18px 20px;margin:2px 0 16px}
.qtext{font-size:22px;line-height:1.7;font-weight:700;letter-spacing:.3px;word-break:break-word}
@media(max-width:600px){.qtext{font-size:18.5px}}
.qindex{font-size:12.5px;color:var(--ink3);letter-spacing:1.2px;font-weight:700;margin-bottom:6px}

/* ---------- timer ---------- */
.timerwrap{display:flex;align-items:center;gap:15px;flex-wrap:wrap;padding:13px 15px;border:1.5px solid var(--line);
  border-radius:16px;background:var(--bg2);margin-bottom:15px}
.ring{width:66px;height:66px;flex:none;transform:rotate(-90deg)}
.ring circle{fill:none;stroke-width:6.5;stroke-linecap:round}
.ring .bg{stroke:var(--line)}
.ring .fg{stroke:var(--brand);transition:stroke-dashoffset .2s linear,stroke .3s}
.ring.warn .fg{stroke:var(--coral)} .ring.over .fg{stroke:#e03131}
.timenum{font-size:27px;font-weight:800;font-variant-numeric:tabular-nums;min-width:78px;letter-spacing:-.5px}
.timenum.over{color:#e03131}
.timeset{display:flex;gap:6px;flex-wrap:wrap}
.timeset button{border:1.5px solid var(--line);background:var(--card);color:var(--ink2);border-radius:10px;
  padding:6px 11px;font-size:12.5px;cursor:pointer;font-family:inherit;font-weight:600;transition:.15s}
.timeset button:hover{border-color:var(--brand2);color:var(--brand)}
.timeset button.active{background:var(--brand);border-color:var(--brand);color:#fff}

/* ---------- stars / rating ---------- */
.rate{display:flex;align-items:center;gap:4px;margin-top:12px;font-size:13px;color:var(--ink3)}
.star{cursor:pointer;font-size:22px;filter:grayscale(1);opacity:.35;transition:.15s;line-height:1}
.star:hover{transform:scale(1.18)}
.star.on{filter:none;opacity:1}

/* ---------- meta ---------- */
.meta{background:var(--bg2);border:1px dashed var(--line);border-radius:15px;padding:14px 16px;margin-top:15px;font-size:13.5px;color:var(--ink2)}
.meta h4{margin:0 0 9px;font-size:12.5px;color:var(--ink3);letter-spacing:.8px;text-transform:uppercase}
.meta dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:6px 14px}
.meta dt{color:var(--ink3);white-space:nowrap;font-weight:600}
.meta dd{margin:0;color:var(--ink)}
.meta .quote{border-left:3px solid var(--brand2);padding:6px 0 6px 11px;margin:11px 0 0;white-space:pre-wrap}

details.fold{margin-top:13px}
details.fold summary{cursor:pointer;font-size:13.5px;color:var(--brand);list-style:none;padding:9px 0;font-weight:700}
details.fold summary::-webkit-details-marker{display:none}
details.fold summary:before{content:"▸ ";transition:.2s}
details.fold[open] summary:before{content:"▾ "}
textarea{width:100%;min-height:92px;border:1.5px solid var(--line);border-radius:13px;background:var(--bg2);
  color:var(--ink);padding:12px;font-family:inherit;font-size:14px;resize:vertical;outline:none;line-height:1.6}
textarea:focus{border-color:var(--brand);background:var(--card)}

.progress{height:9px;border-radius:99px;background:var(--line);overflow:hidden;margin:12px 0 15px}
.progress i{display:block;height:100%;background:linear-gradient(90deg,var(--brand),var(--grape));border-radius:99px;transition:width .35s}
.qhistory{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:8px}
.qdot{width:28px;height:28px;border-radius:9px;border:1.5px solid var(--line);background:var(--card);font-size:11.5px;
  color:var(--ink3);display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:700;transition:.15s}
.qdot:hover{transform:translateY(-2px);border-color:var(--brand2)}
.qdot.done{background:var(--mint);border-color:var(--mint);color:#fff}
.qdot.cur{background:linear-gradient(120deg,var(--brand),var(--grape));border-color:transparent;color:#fff}

/* ---------- fav / list ---------- */
.favlist{display:flex;flex-direction:column;gap:10px}
.favitem{border:1.5px solid var(--line);border-radius:14px;padding:12px 14px;background:var(--bg2);display:flex;gap:12px;align-items:flex-start;transition:.16s}
.favitem:hover{border-color:var(--brand2);transform:translateX(2px)}
.favitem .txt{flex:1;font-size:14.5px;font-weight:600}
.favitem .src{font-size:12px;color:var(--ink3);margin-top:5px;font-weight:500}
.empty{text-align:center;color:var(--ink3);padding:40px 10px;font-size:14.5px}
.empty .em{font-size:40px;display:block;margin-bottom:8px}

/* ---------- stats ---------- */
.statgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
@media(max-width:700px){.statgrid{grid-template-columns:repeat(2,1fr)}}
.statbox{border:1.5px solid var(--line);border-radius:15px;padding:14px;background:var(--bg2);text-align:center}
.statbox .n{font-size:27px;font-weight:800;color:var(--brand);line-height:1.2}
.statbox .t{font-size:12px;color:var(--ink3);font-weight:600;margin-top:2px}
.bar{display:flex;align-items:center;gap:10px;margin:7px 0;font-size:13px}
.bar .nm{width:74px;color:var(--ink2);font-weight:600;flex:none;font-size:12.5px}
.bar .tr{flex:1;height:10px;border-radius:99px;background:var(--line);overflow:hidden}
.bar .tr i{display:block;height:100%;border-radius:99px}
.bar .vl{width:34px;text-align:right;color:var(--ink3);font-weight:700;font-size:12px}
.spark{display:flex;align-items:flex-end;gap:6px;height:76px;margin-top:8px}
.spark div{flex:1;background:linear-gradient(180deg,var(--brand2),var(--brand));border-radius:6px 6px 3px 3px;min-height:4px;transition:.3s}
.spark span{font-size:10px;color:var(--ink3);text-align:center;display:block;margin-top:4px}

/* ---------- modal ---------- */
.modal-bg{position:fixed;inset:0;background:rgba(18,22,40,.6);backdrop-filter:blur(3px);display:flex;align-items:flex-start;
  justify-content:center;padding:34px 16px;z-index:120;overflow:auto;animation:fade .2s}
@keyframes fade{from{opacity:0}to{opacity:1}}
.modal{background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow2);width:100%;max-width:780px;padding:22px 24px;animation:pop .28s}
.modal h3{margin:0 0 4px;font-size:19px}
.modal .msub{color:var(--ink3);font-size:12.5px;margin-bottom:15px}
.qlist{counter-reset:qn;display:flex;flex-direction:column;gap:10px;margin:6px 0 16px;padding:0}
.qlist li{list-style:none;background:var(--bg2);border:1.5px solid var(--line);border-radius:13px;padding:11px 14px;font-size:14.5px;font-weight:600}
.qlist li:before{counter-increment:qn;content:counter(qn);display:inline-block;width:23px;height:23px;line-height:23px;
  text-align:center;border-radius:8px;background:linear-gradient(120deg,var(--brand),var(--grape));color:#fff;font-size:12px;margin-right:9px;vertical-align:1px}
.qlist li .src{display:block;font-size:12px;color:var(--ink3);margin-top:5px;padding-left:32px;font-weight:500}
.adminrow{display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;margin-bottom:14px}
.adminrow .f{flex:1;min-width:150px}
.adminrow label{display:block;font-size:12px;color:var(--ink3);margin-bottom:5px;font-weight:600}
table.tb{width:100%;border-collapse:collapse;font-size:13px}
table.tb th{text-align:left;color:var(--ink3);font-size:11.5px;padding:8px 8px;border-bottom:1.5px solid var(--line);text-transform:uppercase;letter-spacing:.5px}
table.tb td{padding:9px 8px;border-bottom:1px solid var(--line);vertical-align:top}
table.tb tr:hover td{background:var(--bg2)}
table.tb .qt{font-weight:600;max-width:420px}
.tbwrap{max-height:440px;overflow:auto;border:1.5px solid var(--line);border-radius:14px}
.pager{display:flex;gap:8px;align-items:center;justify-content:center;margin-top:12px;font-size:13px;color:var(--ink2)}

/* ---------- toast / shield ---------- */
#toast{position:fixed;left:50%;bottom:30px;transform:translateX(-50%);z-index:200;display:flex;flex-direction:column;gap:8px;align-items:center;pointer-events:none}
.tst{background:var(--ink);color:var(--bg);padding:10px 18px;border-radius:13px;font-size:13.5px;font-weight:600;
  box-shadow:var(--shadow2);animation:pop .22s;max-width:88vw}
#shield{position:fixed;inset:0;background:var(--bg);z-index:999;display:none;flex-direction:column;align-items:center;justify-content:center;gap:14px;text-align:center;padding:24px}
#shield.on{display:flex}
#shield .em{font-size:56px}
#shield p{color:var(--ink2);max-width:420px;margin:0;font-size:14.5px}
#boot{position:fixed;inset:0;background:var(--bg);z-index:998;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:16px}
.spin{width:42px;height:42px;border-radius:50%;border:4px solid var(--line);border-top-color:var(--brand);animation:sp .8s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}
#confetti{position:fixed;inset:0;pointer-events:none;z-index:150}
.foot{text-align:center;color:var(--ink3);font-size:12.5px;margin-top:24px;line-height:1.9}
kbd{background:var(--bg2);border:1px solid var(--line);border-bottom-width:2px;border-radius:6px;padding:1px 6px;font-size:11.5px;font-family:inherit;color:var(--ink2);font-weight:700}
.recbox{border:1.5px dashed var(--coral);border-radius:14px;padding:12px 14px;background:var(--coralL);margin-top:12px;font-size:13px;color:var(--ink2)}
.recbox .dotr{width:10px;height:10px;border-radius:50%;background:#e03131;display:inline-block;margin-right:6px;animation:blink 1s infinite}
@keyframes blink{50%{opacity:.25}}
</style>
</head>
<body>

<div id="boot"><div class="spin"></div><div style="color:var(--ink3);font-size:14px">正在載入題庫…</div></div>

<div id="shield">
  <div class="em">🛡️</div>
  <h2 style="margin:0">內容保護已啟動</h2>
  <p>偵測到可能的外洩操作（開發者工具／儲存／列印／複製）。此題庫僅供本人練習，不支援下載與轉發。</p>
  <button class="btn primary" onclick="document.getElementById('shield').classList.remove('on')">我明白了，繼續練習</button>
</div>

