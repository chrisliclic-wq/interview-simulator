/* ---------- 整場模擬 ---------- */
function startMock(forceRi){
  const list=filteredRecords();
  if(!list.length){renderEmpty();return;}
  let pick;
  if(forceRi!=null&&list.some(x=>x.i===forceRi))pick=list.find(x=>x.i===forceRi);
  else{
    const fresh=list.filter(x=>!x.r.qs.every((q,qi)=>practiced.has(key(x.i,qi))));
    const src=fresh.length?fresh:list;pick=src[Math.floor(Math.random()*src.length)];
  }
  const all=pick.r.qs.map((q,qi)=>({ri:pick.i,qi,q})).filter(o=>matchQ({ri:pick.i,qi:o.qi,text:o.q.q,lang:o.q.lang,type:o.q.type}));
  const m=pick.r.intro.match(/(普通話|廣東話|粵語|英文|葡文)/);
  const lg=m?m[1].replace('粵語','廣東話'):'自選語言';
  const intro={ri:pick.i,qi:'intro',q:{q:'請先作 1 分鐘自我介紹（'+lg+'）',lang:lg,type:'面試'}};
  const order=/不需|無需|沒有|無描述/.test(pick.r.intro)?all:[intro].concat(all);
  mock={custom:false,ri:pick.i,title:esc(pick.r.school+' · '+pick.r.major),order:order.length?order:all,idx:0};
  resetTimer();renderMock();
}
