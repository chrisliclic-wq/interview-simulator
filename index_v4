    '<div><label class="f">專業（可自行輸入）</label><input type="text" id="edMajor" list="majList" value="'+esc(r.major)+'">'+
      '<datalist id="majList">'+majors.map(s=>'<option value="'+esc(s)+'">').join('')+'</datalist></div>'+
    '<div><label class="f">作答語言</label><select id="edLang">'+
      ['普通話','廣東話','英文','葡文','未註明'].map(v=>'<option '+(q.lang===v?'selected':'')+'>'+v+'</option>').join('')+'</select></div>'+
    '<div><label class="f">題目類型</label><select id="edType">'+
      ['面試','其他','筆試'].map(v=>'<option '+(q.type===v?'selected':'')+'>'+v+'</option>').join('')+'</select></div>'+
    '</div>'+
    '<div style="margin-top:12px"><label class="f">題目內容</label><textarea id="edText" style="min-height:110px" placeholder="輸入面試官問的題目">'+esc(q.q)+'</textarea></div>'+
    '<div style="margin-top:12px"><label class="f">英文版（選填 · 用於英文題朗讀）</label><textarea id="edEn" style="min-height:64px" placeholder="若此題為英文作答，請填寫英文原句">'+esc(q.en||'')+'</textarea></div>'+
    '<div class="grid two" style="margin-top:12px">'+
    '<div><label class="f">自我介紹語言</label><input type="text" id="edIntro" value="'+esc(r.intro)+'"></div>'+
    '<div><label class="f">考試形式</label><input type="text" id="edForm" value="'+esc(r.form)+'"></div>'+
    '<div><label class="f">考官人數</label><input type="text" id="edExm" value="'+esc(r.examiners)+'"></div>'+
    '<div><label class="f">面試時長</label><input type="text" id="edDur" value="'+esc(r.duration)+'"></div>'+
    '</div>'+
    '<div class="btnrow" style="margin-top:16px"><button class="btn primary" id="edSave">💾 儲存</button>'+
    (isNew?'':'<button class="btn coral" id="edDel">🗑 刪除這題</button>')+
    '<button class="btn ghost" id="edCancel">取消</button></div></div></div>';
  $('#modalWrap').innerHTML=h;
  $('#edCancel').onclick=closeList;
  $('#edSave').onclick=async()=>{
    const text=$('#edText').value.trim();
    if(!text){toast('題目內容不能空白');return;}
    const school=$('#edSchool').value.trim()||'自訂學校',major=$('#edMajor').value.trim()||'自訂專業';
    const lang=$('#edLang').value,type=$('#edType').value;
    if(isNew){
      let target=RECORDS.find(x=>x.school===school&&x.major===major&&x.year===$('#edYear').value.trim());
      if(!target){
        target={year:$('#edYear').value.trim()||'2025-26',region:$('#edRegion').value,school,major,
          intro:$('#edIntro').value.trim(),form:$('#edForm').value.trim(),examiners:$('#edExm').value.trim(),
          duration:$('#edDur').value.trim(),hardest:'',feeling:'',qs:[]};
        RECORDS.push(target);
      }
      target.qs.push({q:text,lang,type,en:$('#edEn').value.trim()});
      toast('已新增題目');
    }else{
      const rr=RECORDS[ri];
      rr.year=$('#edYear').value.trim();rr.region=$('#edRegion').value;rr.school=school;rr.major=major;
      rr.intro=$('#edIntro').value.trim();rr.form=$('#edForm').value.trim();rr.examiners=$('#edExm').value.trim();
      rr.duration=$('#edDur').value.trim();
      rr.qs[qi]={q:text,lang,type,en:$('#edEn').value.trim()};
      toast('已儲存修改');
    }
    buildPool();await saveBank();renderStats();refreshOptions();updateCount();closeList();renderAdmin();
  };
  const d=$('#edDel');
  if(d)d.onclick=async()=>{
    if(!confirm('確定刪除這條題目？'))return;
    RECORDS[ri].qs.splice(qi,1);
    if(!RECORDS[ri].qs.length)RECORDS.splice(ri,1);
    buildPool();await saveBank();renderStats();closeList();renderAdmin();toast('已刪除');
  };
}

/* ---------- confetti ---------- */
function confetti(){
  const c=$('#confetti'),ctx=c.getContext('2d');
  c.width=innerWidth;c.height=innerHeight;
  const P=[],cols=['#4f5bd5','#9775fa','#ff7a59','#12b886','#ffc078'];
  for(let i=0;i<110;i++)P.push({x:Math.random()*c.width,y:-20-Math.random()*c.height*.5,
    w:6+Math.random()*7,h:8+Math.random()*8,v:2.5+Math.random()*3.5,r:Math.random()*6,c:cols[i%cols.length]});
  let f=0;
  (function loop(){
    ctx.clearRect(0,0,c.width,c.height);
    P.forEach(p=>{p.y+=p.v;p.r+=.06;ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.r);
      ctx.fillStyle=p.c;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();});
    f++;
    if(f<190)requestAnimationFrame(loop);else ctx.clearRect(0,0,c.width,c.height);
  })();
}

/* ---------- 共用 ---------- */
function renderEmpty(){$('#stage').innerHTML='<div class="empty"><span class="em">😶</span>這個篩選條件下沒有題目<br>試試放寬年度、大學或語言條件</div>';}
function syncTabs(){document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.mode===mode));}
function updateCount(){$('#cntQ').textContent=filteredPool().length;$('#cntR').textContent=filteredRecords().length;}
function renderStage(){
  if(mode==='fav')renderFav();
  else if(mode==='stat')renderStat();
  else if(mode==='admin')renderAdmin();
  else if(mode==='mock'){if(!mock)startMock();else renderMock();}
  else{if(!current)drawQuestion();else renderSingle();}
}
function onFilter(){
  updateCount();
  if(mode==='single'){current=null;drawQuestion();}
  else if(mode==='mock'){mock=null;startMock();}
  else if(mode==='stat')renderStat();
}

/* ---------- 防外漏 ---------- */
function guard(){
  const block=e=>{e.preventDefault();shield();};
  document.addEventListener('contextmenu',block);
  document.addEventListener('copy',e=>{ if(!(e.target&&e.target.matches&&e.target.matches('input,textarea')))block(e); });
  document.addEventListener('cut',e=>{ if(!(e.target&&e.target.matches&&e.target.matches('input,textarea')))block(e); });
  document.addEventListener('selectstart',e=>{ if(!(e.target&&e.target.matches&&e.target.matches('input,textarea')))e.preventDefault(); });
  document.addEventListener('dragstart',block);
  document.addEventListener('keydown',e=>{
    const k=(e.key||'').toUpperCase();
    const c=e.ctrlKey||e.metaKey;
    const inField=e.target&&e.target.matches&&e.target.matches('input,textarea');
    if(k==='F12'||(c&&e.shiftKey&&['I','J','C'].includes(k))||(c&&['S','P','U'].includes(k))){block(e);}
    else if(c&&['A','X'].includes(k)&&!inField){block(e);}
  },true);
  window.addEventListener('beforeprint',e=>{e.preventDefault();shield();});
  setInterval(()=>{
    const dw=outerWidth-innerWidth,dh=outerHeight-innerHeight;
    if(dw>200||dh>200)shield();
  },2000);
}
function shield(){ const s=$('#shield'); if(!s.classList.contains('on')){s.classList.add('on');} }

/* ---------- 事件 ---------- */
function bindFilters(){
  const bind=(id,fn)=>{$(id).onchange=e=>{fn(e.target.value);refreshOptions();onFilter();};};
  bind('#fYear',v=>F.year=v);bind('#fRegion',v=>F.region=v);bind('#fSchool',v=>F.school=v);
  bind('#fLang',v=>F.lang=v);bind('#fType',v=>F.type=v);
  $('#fNew').onchange=e=>{F.onlyNew=e.target.checked;onFilter();};
  let t=null;$('#fKw').oninput=e=>{clearTimeout(t);t=setTimeout(()=>{F.kw=e.target.value.trim();onFilter();},220);};
  $('#resetBtn').onclick=()=>{
    Object.assign(F,{year:'',region:'',school:'',majors:[],lang:'',type:'',kw:'',onlyNew:false});
    ['#fYear','#fRegion','#fSchool','#fLang','#fType'].forEach(s=>$(s).value='');
    $('#fKw').value='';$('#fNew').checked=false;refreshOptions();renderMajor();onFilter();toast('已重設篩選');
  };
}
document.addEventListener('DOMContentLoaded',()=>{
  document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>{
    mode=t.dataset.mode;syncTabs();
    if(mode==='single'){if(!current)drawQuestion();else{resetTimer();renderSingle();}}
    else if(mode==='mock'){if(!mock||mock.custom||mock.idx>=mock.order.length)startMock();else{resetTimer();renderMock();}}
    else if(mode==='fav')renderFav();
    else if(mode==='stat')renderStat();
    else if(mode==='admin'){adminOn?renderAdmin():openAdmin();}
  });
  $('#listBtn2').onclick=openList;
  $('#adminBtn').onclick=()=>{adminOn?renderAdmin():openAdmin();};
  $('#themeBtn').onclick=()=>{
    const d=document.body.classList.toggle('dark');LS.set('ms_theme',d?'dark':'light');
    $('#themeBtn').textContent=d?'☀️':'🌙';
  };
  document.addEventListener('keydown',e=>{
    const tg=e.target||document.body;
    if(tg.matches&&tg.matches('input,textarea,select'))return;
    const k=(e.key||'').toLowerCase();
    if(k==='escape'){closeList();return;}
    if(k==='n'){mode==='mock'?$('#mNext')&&$('#mNext').click():drawQuestion();}
    else if(k==='s'){$('#timerBtn')&&$('#timerBtn').click();}
    else if(k==='f'&&mode==='single'&&current){toggleFav(current);renderSingle();}
    else if(k==='r'){
      if(mode==='single'&&current){const r0=RECORDS[current.ri],q0=r0.qs[current.qi]||{};speak(current.text,current.lang,q0.en);}
      else if(mode==='mock'&&mock){const c=mock.order[mock.idx];if(c)speak(c.q.q,c.q.lang,c.q.en);}
    }
  });
  guard();
});

/* ---------- 啟動 ---------- */
(async function init(){
  try{
    if(LS.get('ms_theme','light')==='dark'){document.body.classList.add('dark');$('#themeBtn').textContent='☀️';}
    const raw=document.getElementById('bankData').textContent.trim();
    let bank=LS.get('ms_bank_v2',null);
    if(!bank) bank=JSON.parse(raw);
    RECORDS=await decryptBank(bank);
    if(!Array.isArray(RECORDS)||!RECORDS.length)throw 0;
    if(!LS.get('ms_bank_v2',null)) await saveBank();
  }catch(e){
    try{ RECORDS=await decryptBank(JSON.parse(document.getElementById('bankData').textContent.trim())); }
    catch(e2){ RECORDS=[]; }
  }
  if(!RECORDS.length){
    document.body.innerHTML='<div style="padding:60px;text-align:center;color:#888">'+
      '題庫載入失敗：此瀏覽器版本不支援加密功能，請改用 Chrome / Edge / Safari 最新版本開啟。</div>';
    return;
  }
  buildPool();
  fillSelect($('#fYear'),uniq(RECORDS.map(r=>r.year)).reverse(),'全部年度');
  fillSelect($('#fRegion'),uniq(RECORDS.map(r=>r.region)),'全部地區');
  fillSelect($('#fLang'),uniq(POOL.map(p=>p.lang)),'全部語言');
  refreshOptions();renderMajor();renderStats();updateCount();bindFilters();initMajor();
  $('#boot').style.display='none';
  drawQuestion();
})();
</script>
