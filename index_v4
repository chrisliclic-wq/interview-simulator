<script id="bankData" type="text/plain">{"v":2,"iter":120000,"salt":"9daKMV8m9dShN0YppSB8HQ==","iv":"Do0iE6p5X5h+lx09","ct":""}</script>

<script>
/* =========================================================
   升學面試模擬器 · 題庫加密儲存 + 可編輯 + 防外漏
   ========================================================= */
const _PP = atob('aW50ZXJ2aWV3LWJhbmstMjAyNg==');
const LS = {
  get(k,d){ try{const v=localStorage.getItem(k); return v?JSON.parse(v):d;}catch(e){return d;} },
  set(k,v){ try{localStorage.setItem(k,JSON.stringify(v));}catch(e){} }
};
const esc = s => String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const $ = s => document.querySelector(s);
const uniq = a => [...new Set(a.filter(Boolean))].sort((x,y)=>x.localeCompare(y,'zh-Hant'));
const key = (ri,qi) => ri + '_' + qi;

/* ---------- 加密題庫 ---------- */
async function deriveKey(pass, salt, iter){
  const km = await crypto.subtle.importKey('raw', new TextEncoder().encode(pass), 'PBKDF2', false, ['deriveKey']);
  return crypto.subtle.deriveKey({name:'PBKDF2', salt, iterations:iter, hash:'SHA-256'}, km,
    {name:'AES-GCM', length:256}, false, ['encrypt','decrypt']);
}
const b64d = s => Uint8Array.from(atob(s), c=>c.charCodeAt(0));
function b64e(buf){
  const b=new Uint8Array(buf); let s='';
  for(let i=0;i<b.length;i+=0x8000) s+=String.fromCharCode.apply(null, b.subarray(i,i+0x8000));
  return btoa(s);
}
async function decryptBank(o){
  const k = await deriveKey(_PP, b64d(o.salt), o.iter||120000);
  const pt = await crypto.subtle.decrypt({name:'AES-GCM', iv:b64d(o.iv)}, k, b64d(o.ct));
  return JSON.parse(new TextDecoder().decode(pt));
}
async function encryptBank(obj){
  const salt = crypto.getRandomValues(new Uint8Array(16));
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const k = await deriveKey(_PP, salt, 120000);
  const ct = await crypto.subtle.encrypt({name:'AES-GCM', iv}, k, new TextEncoder().encode(JSON.stringify(obj)));
  return {v:2, iter:120000, salt:b64e(salt), iv:b64e(iv), ct:b64e(ct)};
}

/* ---------- 全域狀態 ---------- */
let RECORDS = [], POOL = [];
let practiced = new Set(LS.get('ms_practiced',[]));
let favs = LS.get('ms_favs',[]);
let notes = LS.get('ms_notes',{});
let rates = LS.get('ms_rates',{});
let days  = LS.get('ms_days',{});
let wrong = LS.get('ms_wrong',[]);
const saveP=()=>LS.set('ms_practiced',[...practiced]);
const saveF=()=>LS.set('ms_favs',favs);
const saveN=()=>LS.set('ms_notes',notes);
const saveR=()=>LS.set('ms_rates',rates);
const saveD=()=>LS.set('ms_days',days);
const saveW=()=>LS.set('ms_wrong',wrong);
const saveBank = async () => LS.set('ms_bank_v2', await encryptBank(RECORDS));

const F = {year:'',region:'',school:'',majors:[],lang:'',type:'',kw:'',onlyNew:false};
let mode='single', current=null, mock=null;
let timer={total:90,left:90,running:false,over:false,id:null,endAt:0};
let adminOn=false;

function today(){ const d=new Date(); return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'); }
function markDay(){ const t=today(); days[t]=(days[t]||0)+1; saveD(); }

/* ---------- toast ---------- */
function toast(msg){
  const d=document.createElement('div'); d.className='tst'; d.textContent=msg;
  $('#toast').appendChild(d); setTimeout(()=>{d.style.opacity='0';d.style.transition='.3s';},1600);
  setTimeout(()=>d.remove(),2000);
}

/* ---------- 題目池 ---------- */
function buildPool(){
  POOL=[];
  RECORDS.forEach((r,ri)=> r.qs.forEach((q,qi)=>{
    POOL.push({ri,qi,text:q.q,lang:q.lang,type:q.type,en:q.en,school:r.school,major:r.major,year:r.year,region:r.region});
  }));
}

function fillSelect(el,list,ph){
  const cur=el.value;
  el.innerHTML='<option value="">'+ph+'</option>'+list.map(v=>'<option value="'+esc(v)+'">'+esc(v)+'</option>').join('');
  el.value = list.includes(cur)?cur:'';
}
function refreshOptions(){
  const base=RECORDS.filter(r=>(!F.year||r.year===F.year)&&(!F.region||r.region===F.region));
  fillSelect($('#fSchool'),uniq(base.map(r=>r.school)),'全部大學');
  allMajors=uniq(base.filter(r=>!F.school||r.school===F.school).map(r=>r.major));
  F.school=$('#fSchool').value;
  F.majors=F.majors.filter(m=>allMajors.includes(m));
  renderMajor();
}
let allMajors=[];
function renderMajor(){
  const n=F.majors.length;
  $('#mTxt').innerHTML = n? (F.majors[0] + (n>1? ' <span style="color:var(--brand2)">+'+(n-1)+'</span>':'')) : '全部專業';
  $('#mCount').textContent='已選 '+n+' / 3';
  const kw=($('#mSearch')?$('#mSearch').value:'').trim().toLowerCase();
  const list=kw?allMajors.filter(m=>m.toLowerCase().includes(kw)):allMajors;
  const full=!kw&&n>=3;
  $('#mOpts').innerHTML=list.length? list.map(m=>{
    const on=F.majors.includes(m);
    return '<label class="mopt'+(full&&!on?' dis':'')+'"><input type="checkbox" data-m="'+esc(m)+'"'+(on?' checked':'')+(full&&!on?' disabled':'')+'>'+esc(m)+'</label>';
  }).join('') : '<div style="padding:12px;text-align:center;color:var(--ink3);font-size:13px">找不到相符的專業</div>';
  document.querySelectorAll('#mOpts input').forEach(c=>c.onchange=()=>{
    const m=c.dataset.m;
    if(c.checked){ if(F.majors.length>=3){c.checked=false;toast('最多只能選 3 個專業');return;} F.majors.push(m); }
    else F.majors=F.majors.filter(x=>x!==m);
    renderMajor();onFilter();
  });
}
function initMajor(){
  $('#mBtn').onclick=e=>{e.stopPropagation();$('#mPanel').classList.toggle('on');$('#mBtn').classList.toggle('open');
    if($('#mPanel').classList.contains('on'))$('#mSearch').focus();};
  $('#mSearch').oninput=renderMajor;
  $('#mSearch').onclick=e=>e.stopPropagation();
  $('#mPanel').onclick=e=>e.stopPropagation();
  $('#mClear').onclick=()=>{F.majors=[];renderMajor();onFilter();};
  document.addEventListener('click',()=>{const p=$('#mPanel');if(p&&p.classList.contains('on')){p.classList.remove('on');$('#mBtn').classList.remove('open');}});
  document.addEventListener('keydown',e=>{if((e.key||'')==='Escape'){const p=$('#mPanel');if(p){p.classList.remove('on');$('#mBtn').classList.remove('open');}}});
}
function matchQ(p){
  if(F.type==='OTHER'){ if(p.type==='面試') return false; }
  else if(F.type && p.type!==F.type) return false;
  if(F.lang && p.lang!==F.lang) return false;
  if(F.onlyNew && practiced.has(key(p.ri,p.qi))) return false;
  if(F.kw && !(p.text+' '+p.school+' '+p.major).toLowerCase().includes(F.kw.toLowerCase())) return false;
  return true;
}
function matchR(r){
  return (!F.year||r.year===F.year)&&(!F.region||r.region===F.region)&&
         (!F.school||r.school===F.school)&&(!F.majors.length||F.majors.includes(r.major));
}
const filteredPool=()=>POOL.filter(p=>matchR(RECORDS[p.ri])&&matchQ(p));
function filteredRecords(){
  return RECORDS.map((r,i)=>({r,i})).filter(o=>matchR(o.r))
    .filter(o=>o.r.qs.some((q,qi)=>matchQ({ri:o.i,qi,text:q.q,lang:q.lang,type:q.type})));
}

/* ---------- 統計 ---------- */
function renderStats(){
  $('#stats').innerHTML=[
    ['面試場次',RECORDS.length],['真題',POOL.length],['大學',uniq(RECORDS.map(r=>r.school)).length],
    ['專業',uniq(RECORDS.map(r=>r.major)).length],['已練習',practiced.size],['收藏',favs.length]
  ].map(([t,v])=>'<span class="hchip">'+t+' <b>'+v+'</b></span>').join('');
  $('#favCount').textContent=favs.length;
}

/* ---------- 音效 ---------- */
let actx=null;
function beep(n,f){
  try{
    actx=actx||new (window.AudioContext||window.webkitAudioContext)();
    for(let i=0;i<n;i++){
      const o=actx.createOscillator(),g=actx.createGain();
      o.frequency.value=f||880;o.connect(g);g.connect(actx.destination);
      const t0=actx.currentTime+i*0.36;
      g.gain.setValueAtTime(.0001,t0);g.gain.exponentialRampToValueAtTime(.16,t0+.02);
      g.gain.exponentialRampToValueAtTime(.0001,t0+.3);
      o.start(t0);o.stop(t0+.32);
    }
  }catch(e){}
}
function speak(text,lang,en){
  try{
    if(!window.speechSynthesis) return toast('此瀏覽器不支援朗讀');
    speechSynthesis.cancel();
    let t=text, lg = lang==='英文'?'en-US':(lang==='廣東話'?'zh-HK':'zh-CN');
    let extra='';
    if(lang==='英文'&&en){ t=en; lg='en-US'; extra='（已譯成英文）'; }
    const u=new SpeechSynthesisUtterance(t);
    u.lang=lg; u.rate=.95;
    const vs=speechSynthesis.getVoices();
    if(vs.length){ const v=vs.find(x=>x.lang&&x.lang.replace('_','-').toLowerCase().startsWith(lg.toLowerCase())); if(v)u.voice=v; }
    speechSynthesis.speak(u);
    toast('🔊 考官讀題中'+extra);
  }catch(e){}
}
function enBox(q){
  if(q.en) return '<div class="ensent"><span class="lb">🇬🇧 English version（朗讀與作答用此版本）</span>'+esc(q.en)+'</div>';
  return '';
}
function speakable(q){ return {text:q.q, lang:q.lang, en:q.en}; }

/* ---------- 計時 ---------- */
function stopTimer(){timer.running=false;if(timer.id)clearInterval(timer.id);timer.id=null;}
function startTimer(){
  if(timer.running){pauseTimer();return;}
  if(!timer.total) return;
  if(timer.over){resetTimer();}
  timer.running=true;timer.endAt=Date.now()+timer.left*1000;
  timer.id=setInterval(tick,120);renderTimer();
}
function pauseTimer(){stopTimer();renderTimer();}
function resetTimer(){stopTimer();timer.left=timer.total;timer.over=false;renderTimer();}
function tick(){
  timer.left=Math.max(-600,(timer.endAt-Date.now())/1000);
  if(timer.left<=0&&!timer.over){timer.over=true;beep(3);toast('⏰ 時間到！');}
  if(timer.left<=-599)stopTimer();
  renderTimer();
}
function setTime(s){stopTimer();timer.total=s;timer.left=s;timer.over=false;renderTimer();}
function renderTimer(){
  const ring=$('#ring'),num=$('#timenum');if(!ring)return;
  const total=timer.total||1,left=Math.max(0,timer.left);
  const ratio=timer.total?Math.max(0,Math.min(1,left/total)):1;
  const C=2*Math.PI*26;
  ring.querySelector('.fg').style.strokeDasharray=C;
  ring.querySelector('.fg').style.strokeDashoffset=C*(1-ratio);
  ring.className='ring'+(timer.over?' over':(timer.running&&left<=10?' warn':''));
  num.className='timenum'+(timer.over?' over':'');
  if(!timer.total)num.textContent='不限時';
  else{const s=Math.ceil(left);num.textContent=(timer.over?'+':'')+Math.floor(Math.abs(s)/60)+':'+String(Math.abs(s)%60).padStart(2,'0');}
  const b=$('#timerBtn');if(b)b.textContent=timer.running?'⏸ 暫停':(timer.over?'↺ 重新':'▶ 開始計時');
}
function timerHTML(){
  return '<div class="timerwrap">'+
   '<svg class="ring" id="ring" viewBox="0 0 64 64"><circle class="bg" cx="32" cy="32" r="26"/><circle class="fg" cx="32" cy="32" r="26"/></svg>'+
   '<div class="timenum" id="timenum">1:30</div>'+
   '<div class="timeset">'+[45,60,90,120,180,0].map(s=>'<button data-sec="'+s+'" class="'+(timer.total===s?'active':'')+'">'+(s?s/60+' 分鐘':'不限時')+'</button>').join('')+'</div>'+
   '<div style="margin-left:auto;display:flex;gap:8px;flex-wrap:wrap">'+
   '<button class="btn primary" id="timerBtn">▶ 開始計時</button><button class="btn" id="resetT">↺ 重設</button></div></div>';
}
function bindTimer(){
  const b=$('#timerBtn'); if(b) b.onclick=startTimer;
  const r=$('#resetT'); if(r) r.onclick=resetTimer;
  document.querySelectorAll('.timeset button').forEach(x=>x.onclick=()=>setTime(+x.dataset.sec));
  renderTimer();
}

function starHTML(k,label){
  const v=rates[k]||0;
  return '<div class="rate"><span>'+(label||'作答後自評信心：')+'</span>'+
    [1,2,3,4,5].map(i=>'<span class="star '+(i<=v?'on':'')+'" data-k="'+esc(k)+'" data-v="'+i+'">⭐</span>').join('')+
    '<span style="margin-left:6px;color:var(--ink3)">'+(v?v+'/5':'未評')+'</span></div>';
}
function bindStars(){
  document.querySelectorAll('.star').forEach(s=>s.onclick=()=>{
    rates[s.dataset.k]=+s.dataset.v; saveR();
    document.querySelectorAll('.star[data-k="'+s.dataset.k+'"]').forEach(x=>x.classList.toggle('on',+x.dataset.v<=+s.dataset.v));
    const lab=s.parentElement.querySelector('span:last-child'); if(lab)lab.textContent=s.dataset.v+'/5';
    beep(1,1200);
  });
}

/* ---------- 單題練習 ---------- */
function drawQuestion(){
  const pool=filteredPool();
  if(!pool.length){renderEmpty();return;}
  const bag=pool.filter(p=>!(current&&p.ri===current.ri&&p.qi===current.qi));
  const src=bag.length?bag:pool;
  current=src[Math.floor(Math.random()*src.length)];
  resetTimer();renderSingle();
}
function renderSingle(){
  if(!current){renderEmpty();return;}
  const p=current,r=RECORDS[p.ri],k=key(p.ri,p.qi),q0=r.qs[p.qi]||{};
  const fav=favs.some(f=>f.k===k),done=practiced.has(k);
  let h='<div class="qcard">';
  h+='<div class="tagrow">';
  h+='<span class="tag">'+esc(p.school)+' · '+esc(p.major)+'</span>';
  h+='<span class="tag lang">💬 '+esc(p.lang)+'</span>';
  h+='<span class="tag type">'+(p.type==='面試'?'🎤 面試題':(p.type==='筆試'?'✍️ 筆試題':'🎭 其他類型'))+'</span>';
  h+='</div>';
  h+='<div class="qbox"><div class="qindex">考官提問</div><div class="qtext">'+esc(p.text)+'</div>'+enBox(q0)+'</div>';
  h+=timerHTML();
  h+=starHTML(k);
  h+='<div class="btnrow" style="margin-top:13px">';
  h+='<button class="btn primary" id="nextBtn">🎲 換一題 (N)</button>';
  h+='<button class="btn '+(fav?'on':'')+'" id="favBtn">'+(fav?'⭐ 已收藏':'☆ 收藏 (F)')+'</button>';
  h+='<button class="btn '+(done?'on':'')+'" id="doneBtn">'+(done?'✓ 已練習':'標記已練習')+'</button>';
  h+='<button class="btn" id="speakBtn">🔊 朗讀 (R)</button>';
  h+='<button class="btn" id="recBtn">🎙 錄音作答</button>';
  h+='<button class="btn ghost" id="mockBtn">🏫 整場模擬</button>';
  h+='</div>';
  h+='<div id="recSlot"></div>';
  h+='<details class="fold"><summary>📝 我的作答筆記（自動暫存）</summary><textarea id="noteBox" placeholder="寫下作答重點、關鍵詞、可用例子…">'+esc(notes[k]||'')+'</textarea></details>';
  h+='</div>';
  $('#stage').innerHTML=h;
  bindTimer();bindStars();
  $('#nextBtn').onclick=drawQuestion;
  $('#favBtn').onclick=()=>{toggleFav(current);renderSingle();};
  $('#doneBtn').onclick=()=>{practiced.has(k)?practiced.delete(k):(practiced.add(k),markDay());saveP();renderStats();renderSingle();};
  $('#speakBtn').onclick=()=>speak(p.text,p.lang,q0.en);
  $('#recBtn').onclick=()=>toggleRec();
  $('#mockBtn').onclick=()=>{mode='mock';syncTabs();startMock(current.ri);};
  const nb=$('#noteBox');if(nb)nb.oninput=()=>{notes[k]=nb.value;saveN();};
}
function toggleFav(p){
  const k=key(p.ri,p.qi),i=favs.findIndex(f=>f.k===k);
  if(i>=0)favs.splice(i,1);
  else favs.push({k,text:p.text,school:p.school,major:p.major,year:p.year,lang:p.lang,en:p.en});
  saveF();renderStats();
}

/* ---------- 錄音（僅本機記憶體，不存檔） ---------- */
let rec={on:false,mr:null,chunks:[],url:null,t0:0,tid:null};
function toggleRec(){
  if(!navigator.mediaDevices||!window.MediaRecorder){toast('此環境不支援錄音');return;}
  if(rec.on){stopRec();return;}
  navigator.mediaDevices.getUserMedia({audio:true}).then(st=>{
    rec.mr=new MediaRecorder(st);rec.chunks=[];
    rec.mr.ondataavailable=e=>rec.chunks.push(e.data);
    rec.mr.onstop=()=>{
      const blob=new Blob(rec.chunks,{type:'audio/webm'});
      rec.url=URL.createObjectURL(blob);
      st.getTracks().forEach(t=>t.stop());
      const slot=$('#recSlot');
      if(slot)slot.innerHTML='<div class="recbox"><b>🎧 你的作答錄音（'+
        Math.round((Date.now()-rec.t0)/1000)+' 秒，只存在本頁，重新整理即消失）</b><br>'+
        '<audio controls src="'+rec.url+'" style="width:100%;margin-top:8px"></audio>'+
        '<div style="margin-top:8px"><button class="btn sm" id="delRec">🗑 刪除錄音</button></div></div>';
      const d=$('#delRec');if(d)d.onclick=()=>{URL.revokeObjectURL(rec.url);rec.url=null;$('#recSlot').innerHTML='';toast('錄音已刪除');};
    };
